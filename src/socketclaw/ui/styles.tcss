$sc-ink: #0a0f18;
$sc-surface: #111827;
$sc-panel: #182235;
$sc-line: #2b3950;
$sc-text: #e7eef7;
$sc-muted: #8fa0b7;
$sc-accent: #66d9c5;
$sc-warning: #f2c14e;
$sc-danger: #ff6b6b;

Screen {
    background: $sc-ink;
    color: $sc-text;
}

#topbar {
    height: 3;
    padding: 0 2;
    background: $sc-surface;
    border-bottom: solid $sc-line;
    align-vertical: middle;
}

#brand {
    width: 22;
    text-style: bold;
    color: $sc-text;
    content-align: left middle;
}

#active-model {
    width: 1fr;
    color: $sc-muted;
    content-align: center middle;
}

#run-state {
    width: 18;
    color: $sc-accent;
    text-style: bold;
    content-align: right middle;
}

#run-state.paused {
    color: $sc-warning;
}

#primary-nav {
    height: 3;
    padding: 0 1;
    background: $sc-surface;
    border-bottom: solid $sc-line;
}

.nav-button {
    width: auto;
    min-width: 14;
    height: 3;
    margin: 0;
    padding: 0 2;
    background: transparent;
    color: $sc-muted;
    border: none;
}

.nav-button:hover,
.nav-button:focus {
    background: $sc-panel;
    color: $sc-text;
    text-style: none;
}

.nav-button.active {
    color: $sc-accent;
    text-style: bold;
    border-bottom: solid $sc-accent;
}

#workspace {
    height: 1fr;
    background: $sc-ink;
}

.workspace-view {
    height: 1fr;
    padding: 1 3;
}

.view-kicker {
    height: 1;
    color: $sc-accent;
    text-style: bold;
}

.view-title {
    width: 1fr;
    height: 2;
    color: $sc-text;
    text-style: bold;
}

.view-heading {
    height: 2;
    margin-top: 1;
    align-vertical: middle;
}

.view-hint {
    width: auto;
    height: 2;
    color: $sc-muted;
    content-align: right middle;
}

.view-copy {
    width: 70;
    height: 3;
    color: $sc-muted;
}

#overview-metrics {
    height: 5;
    border-top: solid $sc-line;
    border-bottom: solid $sc-line;
}

.metric {
    width: 1fr;
    padding: 1 2;
    color: $sc-muted;
    content-align: left middle;
    border-right: solid $sc-line;
}

#overview-body {
    height: 1fr;
    margin-top: 1;
}

#activity-panel {
    width: 2fr;
    padding-right: 2;
    border-right: solid $sc-line;
}

#recent-panel {
    width: 3fr;
    padding-left: 2;
}

.section-label {
    height: 2;
    color: $sc-muted;
    text-style: bold;
}

#activity-sparkline {
    height: 5;
    color: $sc-accent;
}

#overview-events {
    height: 1fr;
}

#activity-empty,
.empty-state {
    margin-top: 2;
    padding: 1 0;
    color: $sc-muted;
}

.target-list,
.settings-summary {
    margin-top: 2;
    color: $sc-muted;
}

.filter-row {
    height: 3;
    margin-bottom: 1;
}

.filter-row Input {
    width: 1fr;
    margin-right: 1;
}

.filter-row Select {
    width: 22;
    margin-left: 1;
}

.filter-row Button {
    width: auto;
    min-width: 14;
}

.inline-state {
    height: 2;
    color: $sc-muted;
}

.inline-state.error {
    color: $sc-danger;
}

.split-workspace {
    height: 1fr;
    border-top: solid $sc-line;
    border-bottom: solid $sc-line;
}

#events-table,
#investigations-table {
    width: 3fr;
    height: 1fr;
}

#event-detail,
#investigation-detail {
    width: 2fr;
    height: 1fr;
    padding: 1 2;
    background: $sc-surface;
    border-left: solid $sc-line;
}

#hosts-table {
    height: 1fr;
    border-top: solid $sc-line;
    border-bottom: solid $sc-line;
}

.action-row {
    height: 3;
    align-horizontal: right;
}

.action-row Button {
    width: auto;
    min-width: 15;
    margin-left: 1;
}

DataTable {
    background: $sc-ink;
    color: $sc-text;
}

DataTable > .datatable--header {
    background: $sc-surface;
    color: $sc-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $sc-panel;
    color: $sc-accent;
}

.settings-grid {
    height: 1fr;
    border-top: solid $sc-line;
    padding-top: 1;
}

.settings-grid > Vertical {
    width: 1fr;
    padding-right: 2;
}

.settings-grid .field-label {
    margin-top: 1;
}

.compact-fields {
    height: 4;
}

.compact-fields > Vertical {
    width: 1fr;
    margin-right: 1;
}

Footer {
    height: 1;
    background: $sc-surface;
    color: $sc-muted;
}

OnboardingScreen {
    align: center middle;
    background: $sc-ink;
}

#onboarding-shell {
    width: 74;
    height: 26;
    padding: 1 2;
    background: $sc-surface;
    border: solid $sc-line;
}

#onboarding-brand {
    height: 2;
    color: $sc-text;
    text-style: bold;
}

#onboarding-kicker {
    height: 1;
    color: $sc-muted;
}

#onboarding-progress {
    height: 2;
    margin-top: 1;
    color: $sc-accent;
}

#onboarding-steps {
    height: 1fr;
    border-top: solid $sc-line;
    padding-top: 1;
}

.onboarding-step {
    height: 1fr;
}

.step-title {
    height: 3;
    color: $sc-text;
    text-style: bold;
}

.step-copy {
    height: 4;
    width: 64;
    color: $sc-muted;
}

.step-note {
    margin-top: 1;
    color: $sc-accent;
}

#api-key,
#onboarding-model,
#onboarding-targets {
    width: 1fr;
    margin-top: 1;
}

.interval-row {
    height: 5;
    margin-top: 1;
}

.interval-row > Vertical {
    width: 1fr;
    margin-right: 2;
}

.field-label {
    height: 1;
    color: $sc-muted;
}

#onboarding-error {
    height: 2;
    color: $sc-danger;
}

#onboarding-actions {
    height: 3;
    align-horizontal: right;
}

#onboarding-actions Button {
    min-width: 14;
    margin-left: 1;
}

HelpScreen {
    align: center middle;
    background: #000000 60%;
}

#help-dialog {
    width: 58;
    height: 16;
    padding: 1 2;
    background: $sc-surface;
    border: solid $sc-accent;
}

#help-title {
    height: 2;
    color: $sc-accent;
    text-style: bold;
}

#help-copy {
    height: 1fr;
    color: $sc-muted;
}

#help-close {
    align-horizontal: right;
}

ConfirmResponseScreen {
    align: center middle;
    background: #000000 70%;
}

#response-dialog {
    width: 62;
    height: 20;
    padding: 1 2;
    background: $sc-surface;
    border: solid $sc-warning;
}

.dialog-kicker {
    height: 2;
    color: $sc-warning;
    text-style: bold;
}

#response-title {
    height: 3;
    color: $sc-text;
    text-style: bold;
}

#response-copy {
    height: 1fr;
    color: $sc-muted;
}

#response-dialog-actions {
    height: 6;
    align-horizontal: right;
}

#response-dialog-actions Button {
    width: auto;
    min-width: 18;
    margin-top: 1;
}

.narrow #active-model {
    display: none;
}

.narrow .workspace-view {
    padding: 1 2;
}

.narrow .view-hint,
.narrow #event-source,
.narrow #recent-panel {
    display: none;
}

.narrow #activity-panel {
    width: 1fr;
    border-right: none;
}

.narrow #events-table,
.narrow #investigations-table {
    width: 3fr;
}

.narrow #event-detail,
.narrow #investigation-detail {
    width: 2fr;
    padding: 0 1;
}

.narrow .settings-grid > Vertical {
    padding-right: 1;
}

.narrow .nav-button {
    min-width: 10;
    padding: 0 1;
}

.narrow #onboarding-shell {
    width: 100%;
    height: 100%;
    border: none;
}
