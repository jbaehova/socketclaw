$sc-ink: $background;
$sc-surface: $surface;
$sc-panel: $panel;
$sc-line: $border;
$sc-text: $text;
$sc-muted: $text-muted;
$sc-accent: $primary;
$sc-warning: $warning;
$sc-danger: $error;

Screen {
    background: $sc-ink;
    color: $sc-text;
}

#topbar {
    height: 3;
    padding: 0 2;
    background: $sc-surface;
    border-bottom: solid $sc-line;
    align-vertical: middle;
}

#brand {
    width: 22;
    text-style: bold;
    color: $sc-text;
    content-align: left middle;
}

#active-model {
    width: 1fr;
    color: $sc-muted;
    content-align: center middle;
}

#run-state {
    width: 18;
    color: $sc-accent;
    text-style: bold;
    content-align: right middle;
}

#run-state.paused {
    color: $sc-warning;
}

#run-state.degraded,
#run-state.offline {
    color: $sc-warning;
}

#primary-nav {
    height: 3;
    padding: 0 1;
    background: $sc-surface;
    border-bottom: solid $sc-line;
}

.nav-button {
    width: auto;
    min-width: 14;
    height: 3;
    margin: 0;
    padding: 0 2;
    background: transparent;
    color: $sc-muted;
    border: none;
    content-align: center middle;
}

.nav-button:hover,
.nav-button:focus {
    background: $sc-panel;
    color: $sc-text;
    text-style: none;
}

.nav-button.active {
    color: $sc-accent;
    text-style: bold;
    background: $sc-panel;
}

#workspace {
    height: 1fr;
    background: $sc-ink;
}

.workspace-view {
    height: 1fr;
    padding: 1 3;
}

.view-kicker {
    height: 1;
    color: $sc-accent;
    text-style: bold;
}

.view-title {
    width: 1fr;
    height: 2;
    color: $sc-text;
    text-style: bold;
}

.view-heading {
    height: 2;
    margin-top: 1;
    align-vertical: middle;
}

.view-hint {
    width: auto;
    height: 2;
    color: $sc-muted;
    content-align: right middle;
}

.view-copy {
    width: 70;
    height: 3;
    color: $sc-muted;
}

#overview-metrics {
    height: 5;
    border-top: solid $sc-line;
    border-bottom: solid $sc-line;
}

.metric {
    width: 1fr;
    padding: 1 2;
    color: $sc-muted;
    content-align: left middle;
    border-right: solid $sc-line;
}

#overview-body {
    height: 1fr;
    margin-top: 1;
}

#activity-panel {
    width: 2fr;
    padding-right: 2;
    border-right: solid $sc-line;
}

#recent-panel {
    width: 3fr;
    padding-left: 2;
}

.section-label {
    height: 2;
    color: $sc-muted;
    text-style: bold;
}

#activity-sparkline {
    height: 5;
    color: $sc-accent;
}

#activity-sparkline > .sparkline--max-color {
    color: $sc-accent;
}

#activity-sparkline > .sparkline--min-color {
    color: $sc-accent 35%;
}

#overview-events {
    height: 1fr;
}

#activity-empty,
.empty-state {
    margin-top: 2;
    padding: 1 0;
    color: $sc-muted;
}

.target-list,
.settings-summary {
    margin-top: 2;
    color: $sc-muted;
}

.filter-row {
    height: 3;
    margin-bottom: 1;
}

.filter-row Input {
    width: 1fr;
    margin-right: 1;
}

.filter-row Select {
    width: 22;
    margin-left: 1;
}

.filter-row Button {
    width: auto;
    min-width: 14;
}

.inline-state {
    height: 2;
    color: $sc-muted;
}

.inline-state.error {
    color: $sc-danger;
}

.split-workspace {
    height: 1fr;
    border-top: solid $sc-line;
    border-bottom: solid $sc-line;
}

#events-table,
#investigations-table {
    width: 3fr;
    height: 1fr;
}

#event-detail,
#investigation-detail {
    width: 2fr;
    height: 1fr;
    padding: 1 2;
    background: $sc-surface;
    border-left: solid $sc-line;
}

#hosts-table {
    height: 1fr;
    border-top: solid $sc-line;
    border-bottom: solid $sc-line;
}

.action-row {
    height: 3;
    align-horizontal: right;
}

.action-row Button {
    width: auto;
    min-width: 15;
    margin-left: 1;
}

Button.-primary {
    background: $sc-accent;
    color: $sc-ink;
    border-top: tall $sc-accent;
    border-bottom: tall $sc-accent;
}

Button.-primary:hover,
Button.-primary:focus {
    background: $sc-accent 85%;
    color: $sc-ink;
    border-top: tall $sc-accent;
    border-bottom: tall $sc-accent;
}

Input:focus {
    border: tall $sc-accent;
}

Select:focus > SelectCurrent {
    border: tall $sc-accent;
}

DataTable {
    background: $sc-ink;
    color: $sc-text;
}

DataTable > .datatable--header {
    background: $sc-surface;
    color: $sc-muted;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $sc-panel;
    color: $sc-accent;
}

MarkdownH2,
MarkdownH3,
MarkdownBullet {
    color: $sc-accent;
}

.settings-grid {
    height: auto;
    min-height: 17;
    margin-bottom: 1;
    border-top: solid $sc-line;
    padding-top: 1;
}

.settings-grid > Vertical {
    width: 1fr;
    padding-right: 2;
}

.settings-guidance {
    height: auto;
    margin-top: 1;
    color: $sc-muted;
}

#settings-footer {
    height: 5;
    background: $sc-ink;
}

#settings-scroll {
    height: 1fr;
}

.compact-fields {
    height: 4;
}

.compact-fields > Vertical {
    width: 1fr;
    margin-right: 1;
}

Footer {
    height: 1;
    background: $sc-surface;
    color: $sc-muted;
}

OnboardingScreen {
    align: center middle;
    background: $sc-ink;
}

#onboarding-shell {
    width: 74;
    height: 26;
    padding: 1 2;
    background: $sc-surface;
    border: solid $sc-line;
}

#onboarding-brand {
    height: 2;
    color: $sc-text;
    text-style: bold;
}

#onboarding-kicker {
    height: 1;
    color: $sc-muted;
}

#onboarding-progress {
    height: 2;
    margin-top: 1;
    color: $sc-accent;
}

#onboarding-steps {
    height: 1fr;
    border-top: solid $sc-line;
    padding-top: 1;
}

.onboarding-step {
    height: 1fr;
}

.step-title {
    height: 3;
    color: $sc-text;
    text-style: bold;
}

.step-copy {
    height: 4;
    width: 64;
    color: $sc-muted;
}

.step-note {
    margin-top: 1;
    color: $sc-accent;
}

#api-key,
#onboarding-targets {
    width: 1fr;
    margin-top: 1;
}

.interval-row {
    height: 5;
    margin-top: 1;
}

.interval-row > Vertical {
    width: 1fr;
    margin-right: 2;
}

.field-label {
    height: 1;
    color: $sc-muted;
}

#onboarding-error {
    height: 2;
    color: $sc-danger;
}

#onboarding-actions {
    height: 3;
    align-horizontal: right;
}

#onboarding-actions Button {
    min-width: 14;
    margin-left: 1;
}

HelpScreen {
    align: center middle;
    background: #000000 60%;
}

#help-dialog {
    width: 58;
    height: 16;
    padding: 1 2;
    background: $sc-surface;
    border: solid $sc-accent;
}

#help-title {
    height: 2;
    color: $sc-accent;
    text-style: bold;
}

#help-copy {
    height: 1fr;
    color: $sc-muted;
}

#help-close {
    align-horizontal: right;
}

ConfirmResponseScreen {
    align: center middle;
    background: #000000 70%;
}

ConfirmTargetRemovalScreen {
    align: center middle;
    background: #000000 70%;
}

#target-removal-dialog {
    width: 58;
    height: 14;
    padding: 1 2;
    background: $sc-surface;
    border: solid $sc-danger;
}

#target-removal-title {
    height: 2;
    color: $sc-text;
    text-style: bold;
}

#target-removal-copy {
    height: 1fr;
    color: $sc-muted;
}

#target-removal-actions {
    height: 3;
    align-horizontal: right;
}

#target-removal-actions Button {
    width: auto;
    min-width: 16;
    margin-left: 1;
}

#response-dialog {
    width: 62;
    height: 20;
    padding: 1 2;
    background: $sc-surface;
    border: solid $sc-warning;
}

.dialog-kicker {
    height: 2;
    color: $sc-warning;
    text-style: bold;
}

#response-title {
    height: 3;
    color: $sc-text;
    text-style: bold;
}

#response-review {
    height: 1fr;
}

#response-copy {
    height: auto;
    color: $sc-muted;
}

.response-section-label {
    height: 2;
    margin-top: 1;
    color: $sc-warning;
    text-style: bold;
}

.response-model-content {
    height: auto;
    padding-left: 1;
    color: $sc-text;
    border-left: solid $sc-line;
}

#response-disclaimer {
    height: auto;
    margin-top: 1;
    color: $sc-muted;
}

#response-dialog-actions {
    height: 3;
    align-horizontal: right;
}

#response-dialog-actions Button {
    width: auto;
    min-width: 18;
    margin-left: 1;
}

.narrow #active-model {
    display: none;
}

.narrow #run-state {
    width: 1fr;
}

.narrow .workspace-view {
    padding: 0 2;
}

.narrow .view-hint,
.narrow #event-source,
.narrow #recent-panel {
    display: none;
}

.narrow .view-kicker {
    display: none;
}

.narrow .view-heading {
    height: 2;
    margin-top: 0;
}

.narrow .filter-row {
    margin-bottom: 0;
}

.narrow .inline-state {
    height: 1;
}

.narrow #activity-panel {
    width: 1fr;
    border-right: none;
}

.narrow .metric {
    padding: 1 1;
}

.narrow #events-table,
.narrow #investigations-table {
    width: 1fr;
}

.narrow #event-detail,
.narrow #investigation-detail {
    display: none;
}

.narrow .settings-grid > Vertical {
    padding-right: 1;
}

.narrow .settings-grid {
    height: auto;
    min-height: 17;
}

.narrow .nav-button {
    min-width: 10;
    padding: 0 1;
}

.narrow #onboarding-shell {
    width: 100%;
    height: 100%;
    border: none;
}

OnboardingScreen.compact #onboarding-shell {
    width: 100%;
    height: 100%;
    padding: 0 2;
    border: none;
}
