/* SocketClaw lives on the terminal surface. Structure comes from spacing. */
Screen {
    background: $background;
    color: $text;
    scrollbar-size: 1 1;
}
Screen:inline {
    height: 85vh;
    min-height: 12;
    max-height: 40;
    border: none;
}
Screen:blur { text-opacity: 100%; }
DashboardScreen { padding: 1 2 0 2; }
#topbar {
    height: 1;
    margin-bottom: 1;
    background: transparent;
}
#brand { width: 1fr; text-style: bold; }
#run-state { width: auto; min-width: 10; color: $success; content-align: right middle; }
#run-state.paused, #run-state.degraded, #run-state.offline { color: $warning; }
#workspace { height: 1fr; min-height: 1; }
.workspace-view { height: 1fr; padding: 0; }
.view-kicker { display: none; }
.view-heading { height: auto; min-height: 1; margin-bottom: 1; }
.view-title { height: auto; min-height: 1; width: 1fr; text-style: bold; }
.view-hint { height: auto; width: auto; max-width: 50%; color: $text-muted; }
.view-copy { height: auto; width: 100%; color: $text-muted; }
.section-label { height: auto; margin-top: 1; margin-bottom: 1; text-style: bold; }
#watch-targets { height: auto; margin-top: 1; }
#watch-summary { height: auto; color: $text-muted; margin-bottom: 1; }
#overview-events { height: 1fr; border: none; padding: 0; background: transparent; }
#overview-events > .option-list--option { padding: 0 0 1 0; }
#overview-events > .option-list--option-highlighted { background: $panel; color: $text; }
#activity-empty { height: 1fr; color: $text-muted; }
#command-bar { height: auto; max-height: 50%; padding-top: 1; }
#command-menu {
    height: auto;
    max-height: 7;
    border: none;
    padding: 0;
    margin: 0 0 1 2;
    background: $background;
}
#command-menu > .option-list--option-highlighted { color: $primary; background: $panel; }
#command-line { height: 1; }
#command-marker { width: 2; color: $primary; text-style: bold; }
#command-input, #command-input:focus { height: 1; padding: 0; border: none; background: transparent; }
#command-hint { height: 1; margin-top: 1; color: $text-muted; }

/* Controls use one line and a visible focus indicator, without button boxes. */
Button {
    height: 1;
    min-height: 1;
    min-width: 0;
    width: auto;
    padding: 0 1;
    border: none;
    background: transparent;
    color: $text-muted;
    content-align: left middle;
}
Button:hover { background: transparent; text-style: underline; }
Button:focus { background: transparent; text-style: reverse; color: $text; }
Button.-primary, Button.-primary:hover { background: transparent; color: $primary; border: none; text-style: bold; }
Button.-primary:focus { text-style: bold reverse; }
Button.-error { background: transparent; color: $error; border: none; }
Button.-success { background: transparent; color: $success; border: none; }
Button:disabled { opacity: 60%; }
Input {
    height: 1;
    min-height: 1;
    border: none;
    padding: 0 1;
    background: $surface;
    margin: 0;
}
Input:focus { border: none; border-left: solid $primary; padding-left: 0; background: $panel; }
Select { height: 1; min-height: 1; border: none; padding: 0; }
SelectCurrent { height: 1; min-height: 1; padding: 0 1; border: none; background: $surface; }
Select:focus > SelectCurrent { border: none; background: $panel; text-style: underline; }
SelectOverlay { max-height: 8; border: solid $border; padding: 0; background: $background; }
TextArea { border: solid $border; background: $surface; }
TextArea:focus { border: solid $primary; }
.field-label { height: auto; color: $text-muted; margin-bottom: 0; }
.filter-row { height: auto; min-height: 1; margin-bottom: 1; }
.filter-row Input { width: 1fr; margin-right: 1; }
.filter-row Select { width: 18; margin-left: 1; }
.filter-row Button { width: auto; min-width: 0; }
.inline-state { height: auto; min-height: 1; max-height: 3; color: $text-muted; margin-bottom: 1; }
.inline-state.error { color: $error; }
.split-workspace { height: 1fr; border: none; }
#events-table, #investigations-table, #hosts-table { width: 1fr; height: 1fr; border: none; }
#event-detail, #investigation-detail { display: none; }
.action-row { height: auto; min-height: 1; margin-top: 1; align-horizontal: left; }
.action-row Button { width: auto; min-width: 0; margin: 0 1 0 0; }
DataTable { background: transparent; color: $text; scrollbar-size: 1 1; }
DataTable > .datatable--header { background: transparent; color: $text-muted; text-style: none; }
DataTable > .datatable--odd-row, DataTable > .datatable--even-row { background: transparent; }
DataTable > .datatable--cursor { background: $panel; color: $primary; text-style: bold; }
DataTable > .datatable--hover { background: $panel; }
Markdown { background: transparent; padding: 0; }
MarkdownH1, MarkdownH2, MarkdownH3 { color: $text; background: transparent; }
MarkdownH2 { border: none; }
MarkdownBullet { color: $primary; }
Footer { height: 1; background: transparent; color: $text-muted; }
Tabs { height: 2; }
Tab { height: 1; padding: 0 1; }
Tabs > .tabs--background { background: transparent; }
#hosts-tabs, #hosts-tabs ContentSwitcher, #hosts-tabs TabPane { height: 1fr; }
#hosts-tabs TabPane { padding: 0; }

/* A form scrolls as one document; its action row stays outside that scroll. */
#settings-scroll { height: 1fr; }
.settings-grid { height: auto; margin-bottom: 1; }
.settings-grid > Vertical { width: 1fr; height: auto; padding-right: 3; }
.settings-grid Input, .settings-grid Select { margin-bottom: 1; }
.settings-guidance { height: auto; margin: 1 0; color: $text-muted; }
#model-policy { height: auto; }
#settings-footer { height: auto; padding-top: 1; }
#settings-state { height: auto; max-height: 3; }
.compact-fields { height: auto; }
.compact-fields > Vertical { width: 1fr; height: auto; margin-right: 1; }

/* First run follows the same left-aligned terminal rhythm. */
OnboardingScreen { align: left top; padding: 1 2 0 2; }
#onboarding-shell { width: 100%; max-width: 88; height: 1fr; padding: 0; background: transparent; border: none; }
#onboarding-brand { height: 1; text-style: bold; }
#onboarding-kicker { height: auto; color: $text-muted; margin-bottom: 1; }
#onboarding-progress { height: 1; color: $primary; margin-bottom: 1; }
#onboarding-steps { height: 1fr; min-height: 2; border: none; padding: 0; }
.onboarding-step { height: 1fr; }
.step-title { height: auto; text-style: bold; margin-bottom: 1; }
.step-copy { height: auto; width: 100%; max-width: 70; color: $text-muted; margin-bottom: 1; }
.step-note { height: auto; margin-top: 1; color: $text-muted; }
#api-key, #onboarding-targets { width: 100%; margin: 1 0; }
.interval-row { height: auto; margin-top: 1; }
.interval-row > Vertical { width: 1fr; height: auto; margin-right: 2; }
#onboarding-error { height: auto; max-height: 3; color: $error; margin-top: 1; }
#onboarding-actions { height: auto; min-height: 1; margin: 1 0; align-horizontal: left; }
#onboarding-actions Button { min-width: 0; width: auto; margin-right: 2; }
OnboardingScreen.compact #onboarding-shell { width: 100%; height: 1fr; padding: 0; border: none; }

/* Readers and decision forms occupy the same surface, with no floating frame. */
HelpScreen, ConfirmResponseScreen, ConfirmTargetRemovalScreen, IncidentComment,
MaintenanceEditor { align: left top; background: $background; padding: 0; }
#help-dialog, #response-dialog, #target-removal-dialog, #case-comment-dialog, #exception-dialog {
    width: 100%; max-width: 90; height: 1fr; max-height: 100%;
    padding: 1 2; border: none; background: $background;
}
#help-title, #target-removal-title, .dialog-kicker { height: auto; margin-bottom: 1; color: $primary; text-style: bold; }
#help-copy, #target-removal-copy { height: 1fr; overflow-y: auto; color: $text-muted; }
#response-title { height: auto; margin-bottom: 1; text-style: bold; }
#response-review { height: 1fr; }
#response-copy, #response-disclaimer, .response-model-content { height: auto; }
.response-section-label { height: auto; margin-top: 1; color: $primary; }
.response-model-content { padding-left: 1; }
#help-close { align-horizontal: left; }
#target-removal-actions, #response-dialog-actions, #case-comment-buttons, #exception-actions {
    height: auto; min-height: 1; margin-top: 1; align-horizontal: left;
}
#target-removal-actions Button, #response-dialog-actions Button, #exception-actions Button {
    width: auto; min-width: 0; margin: 0 1 0 0;
}
DetailScreen, HealthScreen, RuleSettingsScreen, RelatedObservations, IncidentDesk,
IncidentReader, MaintenanceScreen, SettingsConflictScreen {
    background: $background; padding: 0 2; border: none;
}
DetailScreen > Button, HealthScreen > Button { height: 1; margin-top: 1; }
#desk-heading, #desk-title, #case-heading, #case-title { height: auto; min-height: 1; padding: 0; }
#desk-shortcuts { display: none; }
#desk-status, #desk-selection, #case-feedback, #rule-feedback, #maintenance-selection { height: auto; max-height: 3; }
#desk-toolbar { height: 2; margin-bottom: 1; }
#desk-search { height: 1; }
#desk-inspector { display: none; }
#incident-table { width: 1fr; }
#desk-actions, #case-actions, #rule-actions, #maintenance-actions {
    height: auto; min-height: 1; align-horizontal: left; margin-top: 1;
}
#desk-actions Button, #case-actions Button, #rule-actions Button, #maintenance-actions Button {
    width: auto; min-width: 0; margin: 0 1 0 0;
}
#rule-fields Input { height: 1; margin-bottom: 1; }
#case-heading Button { min-width: 0; height: 1; }
#exception-title { height: auto; margin-bottom: 1; }
#exception-feedback { height: auto; max-height: 3; }
#case-comment-title, #case-comment-copy { height: auto; margin-bottom: 1; }
#case-comment-body { height: 1fr; margin-bottom: 0; }
#related-title, #related-state, #maintenance-heading, #maintenance-copy { height: auto; }
#related-actions { height: auto; margin-top: 1; align-horizontal: left; }

/* Width and height are handled independently, including live resize. */
.narrow .view-hint { display: none; }
.narrow .settings-grid { layout: vertical; }
.narrow .settings-grid > Vertical { width: 100%; padding: 0; margin-bottom: 1; }
.narrow .filter-row { height: 2; layout: grid; grid-size: 2; grid-columns: 1fr 1fr; }
.narrow #event-search { column-span: 2; width: 1fr; }
.narrow #event-source, .narrow #event-severity { width: 1fr; }
.short #command-hint { margin-top: 0; }
.short #watch-summary { margin-bottom: 0; }
.short .section-label { margin: 0; }
.short .inline-state { margin-bottom: 0; }
.tiny #command-hint { content-align: left middle; }
.tiny #command-menu { max-height: 4; }
.tiny .filter-row { layout: vertical; }
.tiny .filter-row Input, .tiny .filter-row Select, .tiny .filter-row Button {
    width: 100%; margin: 0 0 1 0;
}
.tiny .action-row, .tiny #desk-actions, .tiny #case-actions, .tiny #rule-actions,
.tiny #maintenance-actions, .tiny #onboarding-actions, .tiny #response-dialog-actions,
.tiny #target-removal-actions, .tiny #exception-actions {
    layout: grid; grid-size: 2; grid-rows: 1; grid-gutter: 0 1; height: auto;
}
.tiny .action-row Button, .tiny #desk-actions Button, .tiny #case-actions Button,
.tiny #rule-actions Button, .tiny #maintenance-actions Button,
.tiny #onboarding-actions Button, .tiny #response-dialog-actions Button,
.tiny #target-removal-actions Button, .tiny #exception-actions Button {
    width: 1fr; min-width: 0; margin: 0; padding: 0;
}
.tiny .interval-row, .tiny .compact-fields { layout: vertical; height: auto; }
.tiny .interval-row > Vertical, .tiny .compact-fields > Vertical {
    width: 100%; height: auto; margin: 0;
}
.tiny #desk-toolbar { layout: vertical; height: 4; }
.tiny #desk-tabs, .tiny #desk-search { width: 100%; }
.tiny #desk-tabs Tab { padding: 0 1; }
.tiny #case-heading { layout: grid; grid-size: 2; height: auto; grid-rows: 1; }
.tiny #case-title { column-span: 2; }

OnboardingScreen:inline { height: 22; max-height: 85vh; }
Screen#_default:inline { height: 1; min-height: 1; }
SettingsConflictScreen { padding: 0; }
#conflict-actions { height: 1; margin: 0; padding: 0; }
SettingsConflictScreen Button { width: 1fr; min-width: 0; margin: 0; padding: 0; }
SettingsConflictScreen.tiny #conflict-actions { layout: grid; grid-size: 2; grid-rows: 1; height: 2; }

.pagination-row { height: 1; margin-top: 1; }
.pagination-row Button { margin-right: 1; }

#onboarding-candidates { height: 5; margin-top: 1; border: solid $border; }
#onboarding-discovery { height: auto; color: $text-muted; margin-top: 1; }

#watch-coverage { height: auto; color: $text-muted; margin-bottom: 1; }
